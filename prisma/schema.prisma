generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== ENUMS ===================== //

enum SportCode {
  BADMINTON
  CRICKET
  FOOTBALL
}

enum TournamentStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
}

enum MatchStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
  PENDING
}

enum ScheduleType {
  MANUAL
  AUTOMATIC
}

enum GameType {
  SINGLES
  DOUBLES
}

enum TournamentType {
  KNOCKOUT
  ROUND_ROBIN
  LEAGUE
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum InvitationType {
  PLAYER
  TEAM
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum TeamMemberRole {
  OWNER // Creator / admin of the team
  PLAYER // Actively plays matches
  SUBSTITUTE // Backup player (optional but useful)
  CAPTAIN // On-field leader (optional but common)
  COACH // Coach / trainer
  MANAGER // Team manager / coordinator
  OFFICIAL // Referee / umpire attached to team (rare but valid)
}

enum AssetEntityType {
  TOURNAMENT
  TEAM
  USER
}

enum AssetType {
  LOGO
  BANNER
  PROFILE_PICTURE
  OTHER
}

// ===================== CORE ===================== //

model User {
  id           String  @id @default(cuid())
  phone        String  @unique
  email        String? @unique
  username     String? @unique
  name         String?
  city         String?
  profileImage String?
  fcmToken     String?

  // organizedTournaments Tournament[]   @relation("TournamentOrganizer")
  sportProfiles        SportProfile[]
  sessions             Session[]

  teamMemberships TeamMember[]

  favoriteTeams    FavoriteTeam[]
  favoriteUsers    FavoriteUser[] @relation("UserFavorites")
  favoritedByUsers FavoriteUser[] @relation("UserFavoritedBy")

  // officiatedMatches        Match[]                 @relation("MatchOfficial")
  tournamentParticipations TournamentParticipant[] @relation("PlayerParticipation")
  invitations              Invitation[]
  matchParticipations      MatchParticipant[]
  requests                 TournamentRequest[]

  // 🏆 NEW: Back relations for wins
  wonMatches     Match[]      @relation("MatchWinnerUser")
  wonTournaments Tournament[] @relation("TournamentWinnerUser")
  wonMatchParts  MatchPart[]  @relation("MatchPartWinnerUser")

  // ✅ ADD THESE TWO MISSING RELATIONS:
  // tournamentOrganizers TournamentOrganizer[]
  // matchOfficials       MatchOfficial[]

  // Add this new relation instead:
  personnel Personnel[] // All tournament/match roles in one place

  // ➕ ADD THIS: Back relation for MatchStats
  matchStats   MatchStats[]
  achievements Achievement[]
  courtStats   CourtStats[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sport {
  id        String    @id @default(cuid())
  code      SportCode @unique
  name      String
  createdAt DateTime  @default(now())
}

model SportProfile {
  id        String    @id @default(cuid())
  userId    String
  sportCode SportCode

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  avatarUrl String?
  bio       String?

  matchesPlayed Int @default(0)
  wins          Int @default(0)
  losses        Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, sportCode])
}

// ===================== TEAMS ===================== //

model Team {
  id        String    @id @default(cuid())
  name      String
  sportCode SportCode

  logo        String?
  city        String?
  isTemporary Boolean @default(false)

  members   TeamMember[]
  favorites FavoriteTeam[]

  tournamentParticipations TournamentParticipant[] @relation("TeamParticipation")
  invitations              Invitation[]
  requests                 TournamentRequest[]

  targetInvitations Invitation[] @relation("TargetTeam")

  // 🏆 NEW: Back relations for wins
  wonMatches     Match[]      @relation("MatchWinnerTeam")
  wonTournaments Tournament[] @relation("TournamentWinnerTeam")
  wonMatchParts  MatchPart[]  @relation("MatchPartWinnerTeam")

  // ➕ ADD THIS: Back relation for MatchStats
  matchStats MatchStats[]

  createdAt         DateTime           @default(now())
  bracketNodes      BracketNode[]
  matchParticipants MatchParticipant[]
}

model TeamMember {
  id     String @id @default(cuid())
  teamId String
  userId String

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  role TeamMemberRole @default(PLAYER)

  @@unique([teamId, userId])
}

model Invitation {
  id String @id @default(cuid())

  type   InvitationType
  status InvitationStatus @default(PENDING)

  // Targets (what you are invited TO)
  tournamentId String?
  matchId      String?
  targetTeamId String? // 👈 NEW (team you are invited to)

  // Invitee (who is being invited)
  playerId String?
  teamId   String?

  tournament Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  match      Match?      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player     User?       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team       Team?       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  // 👇 NEW — isolated
  targetTeam Team? @relation("TargetTeam", fields: [targetTeamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([tournamentId, playerId, teamId], name: "unique_tournament_invitation")
  @@unique([matchId, playerId, teamId], name: "unique_match_invitation")
  @@index([tournamentId])
  @@index([matchId])
}

// ===================== FAVORITES ===================== //

model FavoriteTeam {
  id     String @id @default(cuid())
  userId String
  teamId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, teamId])
}

model FavoriteUser {
  id             String @id @default(cuid())
  userId         String
  favoriteUserId String

  user         User @relation("UserFavorites", fields: [userId], references: [id], onDelete: Cascade)
  favoriteUser User @relation("UserFavoritedBy", fields: [favoriteUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, favoriteUserId])
}

// ===================== AUTH ===================== //

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model OTP {
  id          String   @id @default(cuid())
  phone       String
  code        String?
  sessionInfo String?
  expiresAt   DateTime
  verified    Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([phone])
}

// ===================== TOURNAMENT ===================== //

model Tournament {
  id             String         @id @default(cuid())
  name           String
  sportCode      SportCode
  tournamentType TournamentType

  startDate DateTime
  endDate   DateTime?

  status TournamentStatus @default(DRAFT)

  isPublic      Boolean      @default(false)
  entryFee      Int          @default(0)
  scheduleType  ScheduleType
  matchMakingAt DateTime?

  publicJoinCode String? @unique

  logo   String?
  banner String?
  city   String?

  // organizerId String?
  // organizer   User?   @relation("TournamentOrganizer", fields: [organizerId], references: [id])

  // Keep for backward compatibility (single organizer)
  // organizerId String?
  // organizer   User?   @relation("TournamentOrganizer", fields: [organizerId], references: [id])
  
  // 🆕 NEW: Multiple organizers
  // organizers TournamentOrganizer[]

  // Add this new relation:
  // personnel Personnel[] // All personnel for this tournament

  locations Location[]

  rules TournamentRules?

  participants TournamentParticipant[] @relation("TournamentParticipants")
  matches      Match[]

  // 🏆 Winner tracking - ADD fields and references!
  winnerParticipantId String?                @unique
  winnerParticipant   TournamentParticipant? @relation("TournamentWinnerParticipant", fields: [winnerParticipantId], references: [id])

  // 🏆 NEW: Tournament winner by userId (for singles)
  winnerUserId String?
  winnerUser   User?   @relation("TournamentWinnerUser", fields: [winnerUserId], references: [id])

  // 🏆 NEW: Tournament winner by teamId (for doubles)
  winnerTeamId String?
  winnerTeam   Team?   @relation("TournamentWinnerTeam", fields: [winnerTeamId], references: [id])

  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  invitations  Invitation[]
  requests     TournamentRequest[]
  bracketNodes BracketNode[]
}

model TournamentRules {
  id                 String    @id @default(cuid())
  tournamentId       String    @unique
  playAreas          Int
  partsPerMatch      Int
  gameType           GameType
  maxParticipants    Int // players for singles, teams for doubles
  minParticipants    Int?
  groupsCount        Int?
  teamsPerGroup      Int?
  enableQuarterFinal Boolean   @default(false)
  enableSemiFinal    Boolean   @default(false)
  enableFinal        Boolean   @default(true)
  daysOfWeek         WeekDay[]
  extraConfig        Json?

  reportingSlots ReportingSlot[]

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}

model ReportingSlot {
  id                String @id @default(cuid())
  tournamentRulesId String

  playArea   Int
  dayOfWeek  WeekDay?
  slotIndex  Int?
  reportTime DateTime

  tournamentRules TournamentRules @relation(fields: [tournamentRulesId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([tournamentRulesId, playArea, dayOfWeek, slotIndex])
}

model TournamentParticipant {
  id           String  @id @default(cuid())
  tournamentId String?

  playerId String?
  teamId   String?

  seed       Int?
  eliminated Boolean @default(false)

  // Main tournament relation
  tournament Tournament? @relation("TournamentParticipants", fields: [tournamentId], references: [id], onDelete: Cascade)

  // 🏆 Won a tournament
  wonTournament Tournament? @relation("TournamentWinnerParticipant")
  player        User?       @relation("PlayerParticipation", fields: [playerId], references: [id])
  team          Team?       @relation("TeamParticipation", fields: [teamId], references: [id])

  createdAt DateTime @default(now())
}

// ===================== MATCH ===================== //
model Match {
  id           String    @id @default(cuid())
  name         String?
  tournamentId String?
  sportCode    SportCode
  playArea     Int?

  gameType    GameType
  partsCount  Int
  round       Int? // 1, 2, 3...
  matchNumber Int? // 1, 2, 3... inside a round

  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  status MatchStatus @default(SCHEDULED)

  startTime DateTime?
  endTime   DateTime?

  startedAt   DateTime?
  completedAt DateTime?

  // officialUserId String?
  // official       User?   @relation("MatchOfficial", fields: [officialUserId], references: [id])

  // Keep for backward compatibility (single official)
  // officialUserId String?
  // official       User?   @relation("MatchOfficial", fields: [officialUserId], references: [id])
  
  // 🆕 NEW: Multiple officials
  // officials MatchOfficial[]

  // Add this new relation:
  // personnel Personnel[] // All personnel for this match

  // ✅ Match-scoped participants
  servingParticipantId String?           @unique
  servingParticipant   MatchParticipant? @relation("ServingParticipant", fields: [servingParticipantId], references: [id])

  winnerParticipantId String?           @unique
  winnerParticipant   MatchParticipant? @relation("MatchWinner", fields: [winnerParticipantId], references: [id])

  // 🏆 NEW: Match winner by userId (for singles)
  winnerUserId String?
  winnerUser   User?   @relation("MatchWinnerUser", fields: [winnerUserId], references: [id])

  // 🏆 NEW: Match winner by teamId (for doubles)
  winnerTeamId String?
  winnerTeam   Team?   @relation("MatchWinnerTeam", fields: [winnerTeamId], references: [id])

  // Bracket positioning
  bracketPosition Int? // Position within the round (0-based)

  // Relations
  participants MatchParticipant[]
  parts        MatchPart[]
  events       MatchEvent[]
  tournament   Tournament?        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  invitations  Invitation[]

  // Dependencies - ONE field is enough
  // This represents matches that this match depends on (previous round matches)
  dependsOn MatchDependency[] @relation("MatchDependsOn")

  // This represents matches that depend on this match (next round matches)
  // This is derived from the other side of the same relation
  dependedOnBy MatchDependency[] @relation("MatchDependedOnBy")

  // Bracket node (one-to-one)
  bracketNode BracketNode?

  // ➕ ADD THIS: Back relation for MatchStats
  matchStats MatchStats[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MatchParticipant {
  id      String @id @default(cuid())
  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  teamId String? // ✅ NEW
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  side     Int? // 1 or 2 for doubles
  position Int? // order in match

  // ✅ reverse relations
  servingIn Match?      @relation("ServingParticipant")
  winningIn Match?      @relation("MatchWinner")
  partsWon  MatchPart[] @relation("MatchPartWinner")

  @@unique([matchId, position])
}

model MatchPart {
  id         String @id @default(cuid())
  matchId    String
  partNumber Int
  p1Score    Int    @default(0)
  p2Score    Int    @default(0)

  winnerParticipantId String?
  winnerParticipant   MatchParticipant? @relation("MatchPartWinner", fields: [winnerParticipantId], references: [id], map: "fk_matchPart_winner")

  // 🆕 NEW: Store winner by userId (for singles) - WITH UNIQUE RELATION NAME
  winnerUserId String?
  winnerUser   User?   @relation("MatchPartWinnerUser", fields: [winnerUserId], references: [id])

  // 🆕 NEW: Store winner by teamId (for doubles)
  winnerTeamId String?
  winnerTeam   Team?   @relation("MatchPartWinnerTeam", fields: [winnerTeamId], references: [id])

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, partNumber])
}

model MatchEvent {
  id        String   @id @default(cuid())
  matchId   String
  type      String
  payload   Json
  createdAt DateTime @default(now())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

// Tracks which matches depend on which (for bracket progression)
model MatchDependency {
  id String @id @default(cuid())

  // The match that depends on others (future round match)
  matchId          String
  // The match that must complete first (previous round match)
  dependsOnMatchId String
  // Which position in the current match gets filled (1 = first participant, 2 = second participant)
  position         Int

  // Relations - FIXED: Match the relation names from Match model
  match     Match @relation("MatchDependsOn", fields: [matchId], references: [id], onDelete: Cascade)
  dependsOn Match @relation("MatchDependedOnBy", fields: [dependsOnMatchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([matchId, dependsOnMatchId])
  @@index([matchId])
  @@index([dependsOnMatchId])
}

// Store complete bracket structure for visualization
model BracketNode {
  id           String @id @default(cuid())
  tournamentId String

  // Position in bracket
  round     Int
  nodeIndex Int

  // Which match this node corresponds to
  matchId String? @unique

  // For bye handling
  isBye     Boolean @default(false)
  byeTeamId String?

  // Parent relation (where winner goes)
  parentNodeId String?
  parentNode   BracketNode? @relation("BracketNodeHierarchy", fields: [parentNodeId], references: [id])

  // Children relation (matches that feed into this one)
  childNodes BracketNode[] @relation("BracketNodeHierarchy")

  // Relations
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  match      Match?     @relation(fields: [matchId], references: [id])
  byeTeam    Team?      @relation(fields: [byeTeamId], references: [id])

  createdAt DateTime @default(now())

  @@unique([tournamentId, round, nodeIndex])
  @@index([tournamentId])
  @@index([matchId])
}

// ===================== PERSONNEL (Single Table for ALL) ===================== //

model Personnel {
  id         String   @id @default(cuid())
  entityType String   // "TOURNAMENT" or "MATCH"
  entityId   String   // tournamentId OR matchId
  userId     String
  role       String   // "ORGANIZER", "REFEREE", "SCORER", "UMPIRE", etc.
  isPrimary  Boolean  @default(false)
  joinedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Optional: Add relations to Tournament and Match if you want type safety
  // tournament Tournament? @relation(fields: [entityId], references: [id], onDelete: Cascade, map: "personnel_tournament_fk")
  // match      Match?      @relation(fields: [entityId], references: [id], onDelete: Cascade, map: "personnel_match_fk")

  // ✅ Add these relations to support the personnel fields in Tournament and Match
  // tournament Tournament? @relation(fields: [entityId], references: [id], onDelete: Cascade, map: "personnel_tournament_fk")
  // match      Match?      @relation(fields: [entityId], references: [id], onDelete: Cascade, map: "personnel_match_fk")

  @@unique([entityType, entityId, userId])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([role])
}


// ===================== MATCH STATS ===================== //

model MatchStats {
  id        String    @id @default(cuid())
  userId    String
  matchId   String
  sportCode SportCode
  gameType  GameType
  teamId    String? // For doubles/team sports
  result    String // "WIN", "LOSS", "DRAW"

  // 🎯 Common stats that apply to ALL sports
  pointsScored   Int @default(0)
  pointsConceded Int @default(0)

  createdAt DateTime @default(now())

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team  Team? @relation(fields: [teamId], references: [id])

  // Sport-specific stats in related tables
  badmintonStats BadmintonMatchStats?
  cricketStats   CricketMatchStats?
  footballStats  FootballMatchStats?

  @@unique([userId, matchId])
  @@index([userId, sportCode])
  @@index([sportCode, gameType])
  @@index([createdAt])
}

// ===================== SPORT-SPECIFIC STATS ===================== //

// 🏸 BADMINTON - Deep stats
model BadmintonMatchStats {
  id           String     @id @default(cuid())
  matchStatsId String     @unique
  matchStats   MatchStats @relation(fields: [matchStatsId], references: [id], onDelete: Cascade)

  // Rally stats
  totalRallies Int    @default(0)
  ralliesWon   Int    @default(0)
  longestRally Int    @default(0) // in seconds
  averageRally Float? // average rally length

  // Shot distribution
  smashes  Int @default(0)
  drops    Int @default(0)
  clears   Int @default(0)
  netShots Int @default(0)
  drives   Int @default(0)
  lifts    Int @default(0)

  // Serve stats
  serves      Int @default(0)
  serveAces   Int @default(0)
  serveErrors Int @default(0)

  // Winner/Error analysis
  winners        Int @default(0)
  unforcedErrors Int @default(0)
  forcedErrors   Int @default(0)

  // Shot quality
  forehandShots Int @default(0)
  backhandShots Int @default(0)
  overheadShots Int @default(0)

  // Movement
  distanceCovered Float? // in meters (if tracked)

  // Match flow
  biggestComeback Int? // Points down then won
  longestStreak   Int? // Consecutive points won
}

// 🏏 CRICKET - Deep stats
model CricketMatchStats {
  id           String     @id @default(cuid())
  matchStatsId String     @unique
  matchStats   MatchStats @relation(fields: [matchStatsId], references: [id], onDelete: Cascade)

  // Batting
  runs       Int    @default(0)
  ballsFaced Int    @default(0)
  fours      Int    @default(0)
  sixes      Int    @default(0)
  strikeRate Float?
  dotBalls   Int    @default(0)

  // Dismissal info
  dismissalType String? // "BOWLED", "CAUGHT", "LBW", "RUN_OUT", etc.
  bowlerId      String? // Who got them out
  fielderId     String? // Who caught them

  // Bowling (if they bowled)
  overs          Float?
  maidens        Int    @default(0)
  runsConceded   Int    @default(0)
  wickets        Int    @default(0)
  economy        Float?
  dotBallsBowled Int    @default(0)

  // Fielding
  catches   Int @default(0)
  runOuts   Int @default(0)
  stumpings Int @default(0)

  // Match impact
  isPlayerOfMatch Boolean @default(false)
  matchImpact     Float? // Some impact score
}

// ⚽ FOOTBALL - Deep stats
model FootballMatchStats {
  id           String     @id @default(cuid())
  matchStatsId String     @unique
  matchStats   MatchStats @relation(fields: [matchStatsId], references: [id], onDelete: Cascade)

  // Scoring
  goals        Int @default(0)
  assists      Int @default(0)
  penalties    Int @default(0)
  penaltyGoals Int @default(0)
  ownGoals     Int @default(0)

  // Shooting
  shots         Int    @default(0)
  shotsOnTarget Int    @default(0)
  shotAccuracy  Float?

  // Passing
  passes          Int    @default(0)
  passesCompleted Int    @default(0)
  passAccuracy    Float?
  keyPasses       Int    @default(0) // Chances created
  crosses         Int    @default(0)
  throughBalls    Int    @default(0)

  // Defense
  tackles       Int @default(0)
  tacklesWon    Int @default(0)
  interceptions Int @default(0)
  blocks        Int @default(0)
  clearances    Int @default(0)
  dribbledPast  Int @default(0)

  // Possession
  touches      Int @default(0)
  dispossessed Int @default(0)
  turnovers    Int @default(0)

  // Duels
  duels          Int @default(0)
  duelsWon       Int @default(0)
  aerialDuels    Int @default(0)
  aerialDuelsWon Int @default(0)

  // Fouls
  foulsCommitted Int @default(0)
  foulsWon       Int @default(0)
  offsides       Int @default(0)

  // Cards
  yellowCards Int @default(0)
  redCards    Int @default(0)

  // Goalkeeper specific
  saves          Int     @default(0)
  cleanSheet     Boolean @default(false)
  goalsConceded  Int     @default(0)
  savePercentage Float?

  // Physical
  distanceCovered Float? // in km
  sprints         Int    @default(0)
  topSpeed        Float? // in km/h
}

// ===================== ACHIEVEMENTS & MILESTONES ===================== //

// Track achievements, badges, and streaks
model Achievement {
  id        String    @id @default(cuid())
  userId    String
  sportCode SportCode

  // Achievement info
  type        String // "MILESTONE", "STREAK", "BADGE", "TROPHY"
  name        String // e.g., "Century Club", "Iron Will", "10 Win Streak"
  description String?
  tier        String? // "BRONZE", "SILVER", "GOLD", "PLATINUM"

  // Progress tracking
  progress   Int? // Current progress (e.g., 45/100, current streak: 5)
  target     Int? // Target for completion (e.g., 100, streak target: 10)
  unlockedAt DateTime? // When fully unlocked

  // Streak-specific fields (for streak-type achievements)
  streakType  String? // "WIN_STREAK", "ACTIVITY_STREAK", "CONSECUTIVE_DAYS"
  streakStart DateTime? // When the streak started
  streakEnd   DateTime? // Last activity in streak
  isActive    Boolean? // Whether streak is currently active

  // Display
  icon      String? // Icon URL or emoji
  nameHindi String? // Hindi name for localization
  metadata  Json? // Any additional data

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sportCode, name])
  @@index([userId, sportCode, unlockedAt])
  @@index([userId, sportCode, type])
  @@index([userId, sportCode, streakType, isActive])
}

// ===================== LOCATION STATS ===================== //

// Track performance at different venues
model CourtStats {
  id         String    @id @default(cuid())
  userId     String
  locationId String
  sportCode  SportCode

  matchesPlayed Int       @default(0)
  wins          Int       @default(0)
  losses        Int       @default(0)
  winRate       Float?
  lastPlayedAt  DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId, sportCode])
  @@index([userId, sportCode])
}

// ===================== EXTRAS ===================== //

model Asset {
  id String @id @default(cuid())

  entityType AssetEntityType
  entityId   String // references the id of tournament, team, or user

  type    AssetType
  url     String
  altText String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityType, entityId])
}

model Location {
  id      String  @id @default(cuid())
  name    String
  address String
  city    String?
  state   String?
  country String?
  zipCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tournaments Tournament[]
  matches     Match[]
  courtStats  CourtStats[]

  @@unique([name, address], name: "name_address")
}

model TournamentRequest {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  // Requesting entity
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  status  RequestStatus @default(PENDING)
  message String? // Optional note from requester

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tournamentId, userId, teamId], name: "unique_tournament_request")
  @@index([tournamentId])
  @@index([userId])
  @@index([teamId])
}
